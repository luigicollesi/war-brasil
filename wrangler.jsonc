{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "war-brasil",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "ASSET_STORAGE",
      "bucket_name": "war-brasil-assets-prod"
    }
  ],
  // OpenNext deploys only the Next.js Worker. Keep external Node services off
  // until their production runtimes are deployed separately.
  "vars": {
    "GAME_REALTIME_ENABLED": "false",
    "GAME_AUTOMATION_WORKER_MODE": "off",
    "ASSET_STORAGE_BUCKET": "war-brasil-assets-prod"
  },
  // DATABASE_HYPERDRIVE_URL is the direct/unpooled origin URL and remains a
  // secret. DATABASE_HYPERDRIVE itself is a Cloudflare resource binding and is
  // added separately after creating the Hyperdrive configuration and obtaining
  // its ID. AUTH_DATABASE_URL remains the dedicated direct auth connection.
  "secrets": {
    "required": [
      "DATABASE_URL",
      "DATABASE_HYPERDRIVE_URL",
      "AUTH_DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "AUTH_EMAIL_FROM",
      "EMAIL_TRANSPORT_SECRET",
      "ASSET_STORAGE_URL",
      "ASSET_STORAGE_ACCESS_KEY_ID",
      "ASSET_STORAGE_SECRET_ACCESS_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}
