# WAR Brasil — referência de variáveis de ambiente
#
# Uso local recomendado:
#   cp .env.example .env.local
#
# Nunca coloque segredos reais neste arquivo versionado.

# -----------------------------------------------------------------------------
# Banco de dados — obrigatório
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/war_brasil

# Better Auth usa o schema PostgreSQL `auth` via search_path.
# Se DATABASE_URL for uma conexão Neon pooled (hostname com `-pooler`),
# configure abaixo a conexão DIRETA/UNPOOLED para o mesmo banco.
# Em Postgres local ou conexão já direta, pode ficar ausente e o auth reutiliza
# DATABASE_URL.
# AUTH_DATABASE_URL=postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/banco?sslmode=require

# -----------------------------------------------------------------------------
# Aplicação web
# -----------------------------------------------------------------------------
PORT=3000
SITE_URL=http://localhost:3000

# NEXT_PUBLIC_SITE_URL é opcional. Prefira SITE_URL no servidor.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Autenticação de conta — Better Auth (TODAS server-only)
# -----------------------------------------------------------------------------
# Gere um segredo real e aleatório. Exemplo:
#   openssl rand -base64 48
# O valor abaixo é somente placeholder e é rejeitado pela validação de produção.
BETTER_AUTH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Hosts aceitos para resolução dinâmica do Better Auth, separados por vírgula.
# Em produção não inclua hosts que você não controla.
AUTH_ALLOWED_HOSTS=localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=configure-no-google-cloud
GOOGLE_CLIENT_SECRET=configure-no-google-cloud

# Discord OAuth
DISCORD_CLIENT_ID=configure-no-discord-developer-portal
DISCORD_CLIENT_SECRET=configure-no-discord-developer-portal

# IMPORTANTE:
# - não crie NEXT_PUBLIC_BETTER_AUTH_*, NEXT_PUBLIC_GOOGLE_* ou
#   NEXT_PUBLIC_DISCORD_*;
# - DATABASE_URL, AUTH_DATABASE_URL, BETTER_AUTH_SECRET e client secrets nunca
#   podem entrar em bundle/browser/logs;
# - o transportador real de email de autenticação será configurado server-side
#   em etapa própria; nenhum token de verification/reset deve ser logado.

# -----------------------------------------------------------------------------
# Realtime — configuração recomendada para desenvolvimento local
# -----------------------------------------------------------------------------
# `npm run dev` sobe Next + gateway realtime como processos separados.
GAME_REALTIME_ENABLED=true
GAME_REALTIME_PORT=3001
GAME_REALTIME_EVENT_SOURCE=postgres
GAME_REALTIME_AUTH_MODE=cookie

# O cliente usa o mesmo hostname usado para abrir a página e apenas troca a porta.
# Isso funciona com localhost e também com IP da rede local/celular.
NEXT_PUBLIC_GAME_REALTIME_MODE=hybrid
NEXT_PUBLIC_GAME_REALTIME_PORT=3001
NEXT_PUBLIC_GAME_REALTIME_AUTH_MODE=cookie

# Em desenvolvimento NÃO fixe NEXT_PUBLIC_GAME_REALTIME_URL em localhost.
# Deixe sem definir para permitir acesso via IP/LAN.
# Em produção, defina apenas se o WebSocket não estiver exposto no mesmo host.
# NEXT_PUBLIC_GAME_REALTIME_URL=wss://example.com/realtime

# No ambiente local, scripts/dev.mjs detecta automaticamente localhost,
# 127.0.0.1, ::1 e IPs de rede local.
# Para adicionar hosts extras, separados por vírgula:
# GAME_REALTIME_ALLOWED_HOSTS=dev.example.local

# Worker/realtime usam apenas server-side env.
GAME_WORKER_BASE_URL=http://127.0.0.1:3002
GAME_WORKER_PORT=3002
GAME_WORKER_SECRET=change-me-in-production
GAME_WORKER_TIMEOUT_MS=2500

# Em produção, prefira um segredo separado para assinatura de tickets realtime.
# GAME_REALTIME_TICKET_SECRET=change-me-in-production
