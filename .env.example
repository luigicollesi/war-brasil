# WAR Brasil — referência de variáveis de ambiente
#
# Uso local recomendado:
#   cp .env.example .env.local
#
# Nunca coloque segredos reais neste arquivo versionado.

# -----------------------------------------------------------------------------
# Banco de dados — obrigatório
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/war_brasil

# Better Auth usa o schema PostgreSQL `auth` via search_path.
# Se DATABASE_URL for uma conexão Neon pooled (hostname com `-pooler`),
# configure abaixo a conexão DIRETA/UNPOOLED para o mesmo banco.
# Em Postgres local ou conexão já direta, pode ficar ausente e o auth reutiliza
# DATABASE_URL.
# AUTH_DATABASE_URL=postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/banco?sslmode=require

# -----------------------------------------------------------------------------
# Object storage de assets — Cloudflare R2 / S3 API (server-only)
# -----------------------------------------------------------------------------
# Use exatamente o endpoint HTTPS S3 fornecido pelo Cloudflare R2.
# O bucket é explícito por ambiente; desenvolvimento e produção não devem usar
# o mesmo namespace mutável.
#   desenvolvimento -> war-brasil-assets-dev
#   produção        -> war-brasil-assets-prod
# A região usada pelo R2 é auto. Credenciais ficam em variáveis separadas e
# nunca devem ser expostas ao browser.
# ASSET_STORAGE_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# ASSET_STORAGE_BUCKET=war-brasil-assets-dev
# ASSET_STORAGE_ACCESS_KEY_ID=configure-no-cloudflare-r2
# ASSET_STORAGE_SECRET_ACCESS_KEY=configure-no-cloudflare-r2
#
# O formato legado s3:// com credenciais embutidas continua aceito apenas por
# compatibilidade com ambientes existentes, mas não é o formato recomendado.

# -----------------------------------------------------------------------------
# Aplicação web
# -----------------------------------------------------------------------------
PORT=3000
SITE_URL=http://localhost:3000

# NEXT_PUBLIC_SITE_URL é opcional. Prefira SITE_URL no servidor.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Autenticação de conta — Better Auth (TODAS server-only)
# -----------------------------------------------------------------------------
# Gere um segredo real e aleatório. Exemplo:
#   openssl rand -base64 48
# O valor abaixo é somente placeholder e é rejeitado pela validação de produção.
BETTER_AUTH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Hosts aceitos para resolução dinâmica do Better Auth, separados por vírgula.
# Em produção não inclua hosts que você não controla.
AUTH_ALLOWED_HOSTS=localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=configure-no-google-cloud
GOOGLE_CLIENT_SECRET=configure-no-google-cloud

# Discord OAuth
DISCORD_CLIENT_ID=configure-no-discord-developer-portal
DISCORD_CLIENT_SECRET=configure-no-discord-developer-portal

# Email transacional de autenticação.
# A implementação usa a API HTTP do Resend sem SDK adicional.
# AUTH_EMAIL_FROM precisa apontar para um remetente/domínio validado no provider.
# EMAIL_TRANSPORT_SECRET recebe a credencial server-only do transportador.
# AUTH_EMAIL_FROM=WAR Brasil <acesso@seudominio.com>
# EMAIL_TRANSPORT_SECRET=configure-no-provider-de-email

# IMPORTANTE:
# - não crie NEXT_PUBLIC_BETTER_AUTH_*, NEXT_PUBLIC_GOOGLE_* ou
#   NEXT_PUBLIC_DISCORD_*;
# - DATABASE_URL, AUTH_DATABASE_URL, ASSET_STORAGE_URL, ASSET_STORAGE_BUCKET,
#   ASSET_STORAGE_ACCESS_KEY_ID, ASSET_STORAGE_SECRET_ACCESS_KEY,
#   BETTER_AUTH_SECRET, EMAIL_TRANSPORT_SECRET e client secrets nunca podem
#   entrar em bundle/browser/logs;
# - nenhum token ou URL de verification/reset deve ser logado.

# -----------------------------------------------------------------------------
# Realtime — configuração recomendada para desenvolvimento local
# -----------------------------------------------------------------------------
# `npm run dev` sobe Next + gateway realtime como processos separados.
GAME_REALTIME_ENABLED=true
GAME_REALTIME_PORT=3001
GAME_REALTIME_EVENT_SOURCE=postgres
GAME_REALTIME_AUTH_MODE=cookie
GAME_REALTIME_CHANNEL=war_game_revision

# O cliente usa o mesmo hostname usado para abrir a página e apenas troca a porta.
# Isso funciona com localhost e também com IP da rede local/celular.
NEXT_PUBLIC_GAME_REALTIME_MODE=hybrid
NEXT_PUBLIC_GAME_REALTIME_PORT=3001
NEXT_PUBLIC_GAME_REALTIME_AUTH_MODE=cookie

# Em desenvolvimento NÃO fixe NEXT_PUBLIC_GAME_REALTIME_URL em localhost.
# Deixe sem definir para permitir acesso via IP/LAN.
# Em produção, defina apenas se o WebSocket não estiver exposto no mesmo host.
# NEXT_PUBLIC_GAME_REALTIME_URL=wss://example.com/realtime

# No ambiente local, scripts/dev.mjs detecta automaticamente localhost,
# 127.0.0.1 e os IPs da máquina. Em produção configure explicitamente.
# GAME_REALTIME_ALLOWED_ORIGINS=https://example.com

# Entrega direta de eventos efêmeros e presença entre Next e gateway.
# `npm run dev` define automaticamente URL local + token aleatório compartilhado,
# então normalmente NÃO configure estas duas variáveis no .env.local.
# Em produção, use apenas se Next conseguir acessar uma URL interna do gateway.
# GAME_REALTIME_INTERNAL_URL=http://127.0.0.1:3001
# GAME_REALTIME_INTERNAL_TOKEN=troque-por-um-token-interno-forte

# Patches realtime são opcionais. Sem esta flag, invalidations + snapshot continuam funcionando.
# GAME_REALTIME_PATCHES_ENABLED=true

# Limite opcional de backpressure por socket. Default atual: 65536 bytes.
# GAME_REALTIME_MAX_BUFFERED_BYTES=65536

# -----------------------------------------------------------------------------
# Autenticação realtime por ticket — opcional
# -----------------------------------------------------------------------------
# Use apenas se GAME_REALTIME_AUTH_MODE=ticket|either e
# NEXT_PUBLIC_GAME_REALTIME_AUTH_MODE=ticket.
# O segredo deve ter no mínimo 32 caracteres e ser igual no Next e no gateway.
# GAME_REALTIME_TICKET_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# GAME_REALTIME_TICKET_TTL_SECONDS=45

# -----------------------------------------------------------------------------
# Redis / escala horizontal / presença — opcional
# -----------------------------------------------------------------------------
# Necessário para presença online/offline do Profile e também quando
# GAME_REALTIME_EVENT_SOURCE=dual|redis ou ao usar relay.
# Sem Redis, partidas continuam usando PostgreSQL normalmente e presença vira
# `unavailable` em vez de falso `offline`.
# GAME_REALTIME_REDIS_URL=redis://localhost:6379
# TTL de presença: default 90s, limitado pelo runtime a 30..300s.
# PROFILE_PRESENCE_TTL_SECONDS=90
# Lease distribuída para gravar last_seen_at no PostgreSQL sem escrever a cada
# heartbeat. Default 60s, limitado pelo runtime a 30..900s.
# PROFILE_LAST_SEEN_THROTTLE_SECONDS=60

# -----------------------------------------------------------------------------
# Automação de jogo
# -----------------------------------------------------------------------------
# Browser é o comportamento padrão atual no desenvolvimento.
NEXT_PUBLIC_GAME_AUTOMATION_DRIVER=browser

# Worker separado permanece desligado por padrão.
GAME_AUTOMATION_WORKER_MODE=off
# GAME_AUTOMATION_WORKER_POLL_MS=500
# GAME_AUTOMATION_WORKER_BATCH_SIZE=50
# GAME_AUTOMATION_WORKER_CONCURRENCY=4
# GAME_AUTOMATION_WORKER_LEASE_MS=10000
# GAME_AUTOMATION_WORKER_INSTANCE_ID=war-brasil-worker-1

# Necessários somente para GAME_AUTOMATION_WORKER_MODE=active.
# GAME_AUTOMATION_INTERNAL_BASE_URL=http://localhost:3000
# GAME_AUTOMATION_WORKER_TOKEN=troque-por-um-token-interno-forte
