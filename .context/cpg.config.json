{
  "version": 1,
  "roots": [
    "src",
    "realtime",
    "worker",
    "scripts"
  ],
  "extensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/coverage/**",
    "**/out/**",
    "**/build/**",
    "**/.test-build/**",
    "tests/**",
    "realtime/test/**",
    "worker/test/**",
    "scripts/context/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "supportFiles": [
    "package.json",
    "tsconfig.json",
    "next.config.ts",
    "realtime/package.json"
  ],
  "generatorFiles": [
    "scripts/context/cpg-source.mjs",
    "scripts/context/prepare-cpg-source.mjs",
    "scripts/context/build-cpg.sh",
    "scripts/context/write-cpg-build-metadata.mjs"
  ],
  "generated": {
    "cpgDirectory": ".context/cpg",
    "cacheDirectory": ".context/cache"
  }
}
