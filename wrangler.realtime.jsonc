{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "war-brasil-realtime",
  "main": "realtime/cloudflare/worker.mjs",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "realtime.bellumcivile.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "GAME_REALTIME_ALLOWED_ORIGINS": "https://bellumcivile.com",
    "GAME_REALTIME_MAX_BUFFERED_BYTES": "65536"
  },
  "secrets": {
    "required": [
      "GAME_REALTIME_TICKET_SECRET",
      "GAME_REALTIME_INTERNAL_TOKEN"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM_REALTIME",
        "class_name": "GameRoomRealtimeDurableObject"
      },
      {
        "name": "USER_REALTIME",
        "class_name": "UserRealtimeDurableObject"
      }
    ]
  },
  "exports": {
    "GameRoomRealtimeDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "UserRealtimeDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
